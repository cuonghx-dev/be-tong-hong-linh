// Prisma schema — model bổ sung theo nghiệp vụ (misa-specs).
// Nguyên tắc: tiền dùng Decimal @db.Decimal(18,2); audit created_at/updated_at/created_by;
// soft delete bằng cờ trạng thái, KHÔNG xóa cứng chứng từ; bút toán kép cân Nợ = Có.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// TODO: thêm model theo feature còn lại: catalog, sales, purchase, bank, inventory, report.

// ── Xác thực & phân quyền (auth) ────────────────────────────────────────────

// Vai trò người dùng. Đồng bộ với UserRole trong packages/shared/src/enums.
enum UserRole {
  ADMIN
  KETOAN
  THUQUY
  VIEWER
}

// Người dùng hệ thống. Chưa có đăng ký — tài khoản tạo qua seed (admin) hoặc ADMIN tạo sau này.
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  role         UserRole @default(KETOAN)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("users")
}

// ── Tiền mặt (01-tien-mat) ──────────────────────────────────────────────────

// Loại chứng từ quỹ: Phiếu thu (PT) / Phiếu chi (PC).
enum CashVoucherType {
  RECEIPT
  PAYMENT
}

// Loại nghiệp vụ (§5) — quyết định định khoản mặc định + nguồn sinh phiếu.
enum CashVoucherCategory {
  SALES_CASH
  RECEIPT
  PAYMENT_EMPLOYEE_ADVANCE
  PAYMENT_PURCHASE_WITH_INVOICE
  DEPOSIT_TO_BANK
  PAYMENT
  PURCHASE_SERVICE_CASH
  PURCHASE_GOODS_CASH
}

// Đối tượng liên kết: Khách hàng / Nhà cung cấp / Nhân viên.
enum PartnerType {
  CUSTOMER
  SUPPLIER
  EMPLOYEE
}

// Phiếu thu/chi tiền mặt.
model CashVoucher {
  id              String              @id @default(uuid())
  type            CashVoucherType
  category        CashVoucherCategory
  voucherNo       String              @unique @map("voucher_no")
  postingDate     DateTime            @map("posting_date") @db.Date
  voucherDate     DateTime            @map("voucher_date") @db.Date
  partnerType     PartnerType?        @map("partner_type")
  partnerId       String?             @map("partner_id")
  partnerName     String?             @map("partner_name")
  payerReceiver   String?             @map("payer_receiver")
  address         String?
  employeeId      String?             @map("employee_id")
  reason          String?
  attachmentCount Int                 @default(0) @map("attachment_count")
  totalAmount     Decimal             @default(0) @map("total_amount") @db.Decimal(18, 2)
  branchId        String?             @map("branch_id")
  // Đã ghi sổ (ảnh hưởng sổ sách). Bỏ ghi → còn là nháp, loại khỏi sổ/báo cáo.
  posted          Boolean             @default(true)
  lines           CashVoucherLine[]
  // Đối trừ chứng từ bán hàng (thu tiền khách hàng theo hóa đơn).
  allocations     PaymentAllocation[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")

  @@index([type, postingDate])
  @@index([partnerId])
  @@map("cash_vouchers")
}

// Dòng hạch toán (bút toán kép) của phiếu thu/chi.
model CashVoucherLine {
  id            String      @id @default(uuid())
  voucherId     String      @map("voucher_id")
  voucher       CashVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  lineNo        Int         @map("line_no")
  description   String?
  debitAccount  String      @map("debit_account")
  creditAccount String      @map("credit_account")
  amount        Decimal     @db.Decimal(18, 2)
  operation     String?
  partnerId     String?     @map("partner_id")
  partnerName   String?     @map("partner_name")
  costItemId    String?     @map("cost_item_id")
  bankAccountNo String?     @map("bank_account_no")
  bankName      String?     @map("bank_name")

  @@index([voucherId])
  @@map("cash_voucher_lines")
}

// ── Tiền gửi (02-tien-gui) ──────────────────────────────────────────────────

// Loại chứng từ tiền gửi: Thu tiền gửi (NTTK) / Ủy nhiệm chi (UNC).
enum BankVoucherType {
  RECEIPT
  PAYMENT
}

// Loại nghiệp vụ (§5) — quyết định định khoản mặc định + nguồn sinh phiếu.
enum BankVoucherCategory {
  RECEIPT
  PAYMENT
  SALES_BANK
  PURCHASE_SERVICE_BANK
  PURCHASE_GOODS_BANK
}

// Phương thức thanh toán khi chi (§4) — chỉ dùng cho UNC.
enum BankPaymentMethod {
  UNC
  TRANSFER
  CHECK
}

// Chứng từ thu (NTTK) / chi (UNC) tiền gửi.
model BankVoucher {
  id                String              @id @default(uuid())
  type              BankVoucherType
  category          BankVoucherCategory
  voucherNo         String              @unique @map("voucher_no")
  paymentMethod     BankPaymentMethod?  @map("payment_method")
  isBatchTransfer   Boolean             @default(false) @map("is_batch_transfer")
  internalRef       String?             @map("internal_ref")
  postingDate       DateTime            @map("posting_date") @db.Date
  voucherDate       DateTime            @map("voucher_date") @db.Date
  bankAccountNo     String?             @map("bank_account_no")
  bankName          String?             @map("bank_name")
  receiverAccountNo String?             @map("receiver_account_no")
  partnerType       PartnerType?        @map("partner_type")
  partnerId         String?             @map("partner_id")
  partnerName       String?             @map("partner_name")
  address           String?
  employeeId        String?             @map("employee_id")
  reason            String?
  reference         String?
  attachmentCount   Int                 @default(0) @map("attachment_count")
  totalAmount       Decimal             @default(0) @map("total_amount") @db.Decimal(18, 2)
  branchId          String?             @map("branch_id")
  // Đã ghi sổ (ảnh hưởng sổ sách). Bỏ ghi → còn là nháp, loại khỏi sổ/báo cáo.
  posted            Boolean             @default(true)
  lines             BankVoucherLine[]
  // Đối trừ chứng từ bán hàng (thu tiền khách hàng theo hóa đơn).
  allocations       PaymentAllocation[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")

  @@index([type, postingDate])
  @@index([partnerId])
  @@map("bank_vouchers")
}

// Dòng hạch toán (bút toán kép) của chứng từ thu/chi tiền gửi.
model BankVoucherLine {
  id            String      @id @default(uuid())
  voucherId     String      @map("voucher_id")
  voucher       BankVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  lineNo        Int         @map("line_no")
  description   String?
  debitAccount  String      @map("debit_account")
  creditAccount String      @map("credit_account")
  amount        Decimal     @db.Decimal(18, 2)
  partnerId     String?     @map("partner_id")
  partnerName   String?     @map("partner_name")

  @@index([voucherId])
  @@map("bank_voucher_lines")
}

// ── Mua hàng (03-mua-hang) ───────────────────────────────────────────────────

// Loại chứng từ mua hàng (§5): nhập kho / không qua kho / dịch vụ.
enum PurchaseVoucherType {
  STOCK
  NON_STOCK
  SERVICE
}

// Nguồn gốc hàng mua (§5): trong nước / nhập khẩu.
enum PurchaseOrigin {
  DOMESTIC
  IMPORT
}

// Hình thức thanh toán khi lập chứng từ.
enum PurchasePaymentMode {
  UNPAID
  IMMEDIATE
}

// Trạng thái nhận hóa đơn.
enum PurchaseReceiveStatus {
  NOT_RECEIVED
  RECEIVED
}

// Trạng thái thanh toán công nợ.
enum PurchasePaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

// Loại nhà cung cấp.
enum SupplierType {
  ORG
  INDIVIDUAL
}

// Hình thức thanh toán (khi thanh toán ngay).
enum PaymentMethod {
  CASH
  BANK_TRANSFER
}

// Nhà cung cấp (§6).
model Supplier {
  id                 String       @id @default(uuid())
  code               String       @unique
  name               String
  type               SupplierType @default(ORG)
  isCustomer         Boolean      @default(false) @map("is_customer")
  taxCode            String?      @map("tax_code")
  budgetRelationCode String?      @map("budget_relation_code")
  phone              String?
  website            String?
  address            String?
  groupId            String?      @map("group_id")
  employeeId         String?      @map("employee_id")
  isInternal         Boolean      @default(false) @map("is_internal")
  debtAmount         Decimal      @default(0) @map("debt_amount") @db.Decimal(18, 2)
  invoiceRisk        String?      @map("invoice_risk")
  // Ngừng sử dụng: ẩn khỏi picker khi lập chứng từ, dữ liệu cũ giữ nguyên.
  isActive           Boolean      @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")

  @@index([name])
  @@map("suppliers")
}

// Chứng từ mua hàng (§4).
model PurchaseVoucher {
  id                 String                @id @default(uuid())
  type               PurchaseVoucherType
  origin             PurchaseOrigin        @default(DOMESTIC)
  paymentMode        PurchasePaymentMode   @default(UNPAID) @map("payment_mode")
  paymentMethod      PaymentMethod?        @map("payment_method")
  receiveWithInvoice Boolean               @default(false) @map("receive_with_invoice")
  voucherNo          String                @unique @map("voucher_no")
  invoiceNo          String?               @map("invoice_no")
  postingDate        DateTime              @map("posting_date") @db.Date
  voucherDate        DateTime              @map("voucher_date") @db.Date
  supplierId         String?               @map("supplier_id")
  supplierName       String?               @map("supplier_name")
  deliverer          String?
  address            String?
  employeeId         String?               @map("employee_id")
  description        String?
  attachmentCount    Int                   @default(0) @map("attachment_count")
  contractNo         String?               @map("contract_no")
  paymentTermId      String?               @map("payment_term_id")
  creditDays         Int?                  @map("credit_days")
  dueDate            DateTime?             @map("due_date") @db.Date
  totalGoods         Decimal               @default(0) @map("total_goods") @db.Decimal(18, 2)
  totalVat           Decimal               @default(0) @map("total_vat") @db.Decimal(18, 2)
  totalPayment       Decimal               @default(0) @map("total_payment") @db.Decimal(18, 2)
  purchaseCost       Decimal               @default(0) @map("purchase_cost") @db.Decimal(18, 2)
  stockValue         Decimal               @default(0) @map("stock_value") @db.Decimal(18, 2)
  einvoiceLookupCode String?               @map("einvoice_lookup_code")
  einvoiceLookupUrl  String?               @map("einvoice_lookup_url")
  // Phiếu chi tự sinh khi thanh toán ngay tiền mặt (tham chiếu lỏng, không FK).
  paymentId          String?               @map("payment_id")
  receiveStatus      PurchaseReceiveStatus @default(NOT_RECEIVED) @map("receive_status")
  paymentStatus      PurchasePaymentStatus @default(UNPAID) @map("payment_status")
  // Ghi sổ / bỏ ghi: bỏ ghi = loại khỏi sổ sách nhưng không xóa dữ liệu.
  posted             Boolean               @default(true)
  branchId           String?               @map("branch_id")
  lines              PurchaseVoucherLine[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")

  @@index([type, postingDate])
  @@index([supplierId])
  @@map("purchase_vouchers")
}

// Dòng hàng tiền của chứng từ mua hàng.
model PurchaseVoucherLine {
  id             String          @id @default(uuid())
  voucherId      String          @map("voucher_id")
  voucher        PurchaseVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  lineNo         Int             @map("line_no")
  itemId         String?         @map("item_id")
  itemName       String?         @map("item_name")
  warehouseId    String?         @map("warehouse_id")
  stockAccount   String?         @map("stock_account")
  payableAccount String          @map("payable_account")
  unit           String?
  quantity       Decimal         @default(0) @db.Decimal(18, 4)
  unitPrice      Decimal         @default(0) @map("unit_price") @db.Decimal(18, 2)
  amount         Decimal         @default(0) @db.Decimal(18, 2)
  vatRate        Decimal         @default(0) @map("vat_rate") @db.Decimal(5, 2)
  vatAmount      Decimal         @default(0) @map("vat_amount") @db.Decimal(18, 2)
  vatAccount     String          @map("vat_account")

  @@index([voucherId])
  @@map("purchase_voucher_lines")
}

// ── Kho — Nhập kho (05-kho) ──────────────────────────────────────────────────

// Loại chứng từ Phiếu nhập kho — quyết định định khoản TK Nợ/Có mặc định.
enum InventoryReceiptType {
  PURCHASE
  FINISHED_GOODS
  SALES_RETURN
  OTHER
}

// Phiếu nhập kho (Nhập kho).
model InventoryReceipt {
  id              String                 @id @default(uuid())
  receiptType     InventoryReceiptType   @default(OTHER) @map("receipt_type")
  voucherNo       String                 @unique @map("voucher_no")
  postingDate     DateTime               @map("posting_date") @db.Date
  voucherDate     DateTime               @map("voucher_date") @db.Date
  partnerId       String?                @map("partner_id")
  partnerName     String?                @map("partner_name")
  address         String?
  deliverer       String?
  description     String?
  reference       String?
  attachmentCount Int                    @default(0) @map("attachment_count")
  totalAmount     Decimal                @default(0) @map("total_amount") @db.Decimal(18, 2)
  branchName      String?                @map("branch_name")
  // Ghi sổ / bỏ ghi: bỏ ghi = loại khỏi sổ sách nhưng không xóa dữ liệu.
  posted          Boolean                @default(true)
  lines           InventoryReceiptLine[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")

  @@index([receiptType, postingDate])
  @@map("inventory_receipts")
}

// Dòng hàng của phiếu nhập kho.
model InventoryReceiptLine {
  id            String           @id @default(uuid())
  receiptId     String           @map("receipt_id")
  receipt       InventoryReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  lineNo        Int              @map("line_no")
  itemId        String?          @map("item_id")
  itemName      String?          @map("item_name")
  warehouseId   String?          @map("warehouse_id")
  debitAccount  String?          @map("debit_account")
  creditAccount String?          @map("credit_account")
  unit          String?
  quantity      Decimal          @default(0) @db.Decimal(18, 4)
  unitPrice     Decimal          @default(0) @map("unit_price") @db.Decimal(18, 2)
  amount        Decimal          @default(0) @db.Decimal(18, 2)
  lotNo         String?          @map("lot_no")
  expiryDate    DateTime?        @map("expiry_date") @db.Date

  @@index([receiptId])
  @@map("inventory_receipt_lines")
}

// ── Kho — Xuất kho (05-kho) ──────────────────────────────────────────────────

// Lý do xuất kho — quyết định định khoản TK Nợ/Có mặc định.
enum GoodsIssueCategory {
  SALES
  PRODUCTION
  OTHER
}

// Phiếu xuất kho (Xuất kho) — ghi giảm tồn kho theo bút toán kép.
model GoodsIssueVoucher {
  id                 String             @id @default(uuid())
  category           GoodsIssueCategory @default(SALES)
  voucherNo          String             @unique @map("voucher_no")
  postingDate        DateTime           @map("posting_date") @db.Date
  voucherDate        DateTime           @map("voucher_date") @db.Date
  customerId         String?            @map("customer_id")
  customerName       String?            @map("customer_name")
  receiver           String?
  address            String?
  salesEmployeeId    String?            @map("sales_employee_id")
  description        String?
  attachmentCount    Int                @default(0) @map("attachment_count")
  deliveryLocation   String?            @map("delivery_location")
  totalAmount        Decimal            @default(0) @map("total_amount") @db.Decimal(18, 2)
  salesDocStatus     String?            @map("sales_doc_status")
  invoiceIssueStatus String?            @map("invoice_issue_status")
  taxAuthorityCode   String?            @map("tax_authority_code")
  // Ghi sổ / bỏ ghi: bỏ ghi = loại khỏi sổ sách nhưng không xóa dữ liệu.
  posted             Boolean            @default(true)
  lines              GoodsIssueLine[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")

  @@index([category, postingDate])
  @@index([customerId])
  @@map("goods_issue_vouchers")
}

// Dòng hàng của phiếu xuất kho.
model GoodsIssueLine {
  id            String            @id @default(uuid())
  voucherId     String            @map("voucher_id")
  voucher       GoodsIssueVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  lineNo        Int               @map("line_no")
  itemId        String?           @map("item_id")
  itemName      String?           @map("item_name")
  warehouseId   String?           @map("warehouse_id")
  debitAccount  String            @map("debit_account")
  creditAccount String            @map("credit_account")
  unit          String?
  quantity      Decimal           @default(0) @db.Decimal(18, 4)
  unitPrice     Decimal           @default(0) @map("unit_price") @db.Decimal(18, 2)
  amount        Decimal           @default(0) @db.Decimal(18, 2)
  lotNo         String?           @map("lot_no")
  expiryDate    DateTime?         @map("expiry_date") @db.Date

  @@index([voucherId])
  @@map("goods_issue_lines")
}

// ── Bán hàng (04-ban-hang) ───────────────────────────────────────────────────

// Loại nghiệp vụ chứng từ bán hàng (§3) — quyết định TK doanh thu mặc định.
enum SalesVoucherType {
  DOMESTIC_GOODS
  DOMESTIC_SERVICE
}

// Tùy chọn thanh toán (§3) — quyết định định khoản + sinh phiếu thu.
enum SalesPaymentMode {
  UNPAID
  PAID_NOW
}

// Loại đối tượng khách hàng (§8): Tổ chức / Cá nhân.
enum CustomerType {
  ORG
  INDIVIDUAL
}

// Khách hàng (§8) — đối tượng dùng chung KH/NCC qua cờ isSupplier.
model Customer {
  id                 String       @id @default(uuid())
  code               String       @unique
  name               String
  type               CustomerType @default(ORG)
  isSupplier         Boolean      @default(false) @map("is_supplier")
  isInternal         Boolean      @default(false) @map("is_internal")
  isActive           Boolean      @default(true) @map("is_active")
  // Nhắc nợ tự động (chỉ có tác dụng khi KH còn công nợ).
  debtReminderOn     Boolean      @default(true) @map("debt_reminder_on")
  taxCode            String?      @map("tax_code")
  budgetRelationCode String?      @map("budget_relation_code")
  phone              String?
  website            String?
  address            String?
  groupId            String?      @map("group_id")
  salesEmployeeId    String?      @map("sales_employee_id")
  contactName        String?      @map("contact_name")
  contactEmail       String?      @map("contact_email")
  contactPhone       String?      @map("contact_phone")

  salesVouchers SalesVoucher[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")

  @@index([name])
  @@map("customers")
}

// Chứng từ bán hàng (§3) — ghi nhận doanh thu + công nợ phải thu.
model SalesVoucher {
  id                 String             @id @default(uuid())
  voucherNo          String             @unique @map("voucher_no")
  invoiceNo          String?            @map("invoice_no")
  voucherType        SalesVoucherType   @map("voucher_type")
  paymentMode        SalesPaymentMode   @default(UNPAID) @map("payment_mode")
  paymentMethod      PaymentMethod?     @map("payment_method")
  isInventoryIssue   Boolean            @default(false) @map("is_inventory_issue")
  withInvoice        Boolean            @default(false) @map("with_invoice")
  isPosInvoice       Boolean            @default(false) @map("is_pos_invoice")
  postingDate        DateTime           @map("posting_date") @db.Date
  voucherDate        DateTime           @map("voucher_date") @db.Date
  customerId         String?            @map("customer_id")
  customer           Customer?          @relation(fields: [customerId], references: [id])
  customerName       String?            @map("customer_name")
  taxCode            String?            @map("tax_code")
  contactPerson      String?            @map("contact_person")
  address            String?
  salesEmployeeId    String?            @map("sales_employee_id")
  description        String?
  attachmentCount    Int                @default(0) @map("attachment_count")
  paymentTermId      String?            @map("payment_term_id")
  creditDays         Int?               @map("credit_days")
  dueDate            DateTime?          @map("due_date") @db.Date
  totalGoods         Decimal            @default(0) @map("total_goods") @db.Decimal(18, 2)
  totalVat           Decimal            @default(0) @map("total_vat") @db.Decimal(18, 2)
  totalAmount        Decimal            @default(0) @map("total_amount") @db.Decimal(18, 2)
  einvoiceLookupCode String?            @map("einvoice_lookup_code")
  einvoiceLookupUrl  String?            @map("einvoice_lookup_url")
  receiptId          String?            @map("receipt_id")
  // Chứng từ tự sinh khi thu tiền ngay CK / kiêm phiếu xuất (tham chiếu lỏng, không FK).
  bankReceiptId      String?            @map("bank_receipt_id")
  issueId            String?            @map("issue_id")
  // TKNH nhận tiền khi thu ngay chuyển khoản (tham chiếu lỏng như BankVoucher).
  bankAccountNo      String?            @map("bank_account_no")
  bankName           String?            @map("bank_name")
  // Ghi sổ / bỏ ghi: bỏ ghi = loại khỏi sổ sách nhưng không xóa dữ liệu.
  posted             Boolean            @default(true)
  branchId           String?            @map("branch_id")
  lines              SalesVoucherLine[]
  // Đối trừ thu tiền sau (thu tiền khách hàng theo hóa đơn) — quyết định TT thanh toán.
  allocations        PaymentAllocation[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")

  @@index([voucherType, postingDate])
  @@index([customerId])
  @@index([paymentMode])
  @@map("sales_vouchers")
}

// Dòng hàng tiền của chứng từ bán hàng.
model SalesVoucherLine {
  id             String       @id @default(uuid())
  voucherId      String       @map("voucher_id")
  voucher        SalesVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  lineNo         Int          @map("line_no")
  itemId         String?      @map("item_id")
  itemName       String?      @map("item_name")
  tradeDiscount  Decimal      @default(0) @map("trade_discount") @db.Decimal(18, 2)
  debtAccount    String       @map("debt_account")
  revenueAccount String       @map("revenue_account")
  unit           String?
  quantity       Decimal      @default(0) @db.Decimal(18, 4)
  unitPrice      Decimal      @default(0) @map("unit_price") @db.Decimal(18, 2)
  amount         Decimal      @default(0) @db.Decimal(18, 2)
  vatRate        Decimal      @default(0) @map("vat_rate") @db.Decimal(5, 2)
  vatAmount      Decimal      @default(0) @map("vat_amount") @db.Decimal(18, 2)
  vatAccount     String       @map("vat_account")
  lotNo          String?      @map("lot_no")

  @@index([voucherId])
  @@map("sales_voucher_lines")
}

// Đối trừ thu tiền khách hàng theo hóa đơn (MISA: Thu tiền khách hàng):
// mỗi dòng phân bổ số tiền của 1 phiếu thu (TM) hoặc thu tiền gửi (CK) vào 1 chứng từ
// bán hàng chưa thu. TT thanh toán chứng từ bán = tổng phân bổ so với tổng tiền.
// FK cascade cả 2 phía: xóa chứng từ nguồn hoặc chứng từ bán → đối trừ tự mất.
model PaymentAllocation {
  id             String       @id @default(uuid())
  salesVoucherId String       @map("sales_voucher_id")
  salesVoucher   SalesVoucher @relation(fields: [salesVoucherId], references: [id], onDelete: Cascade)
  // Nguồn tiền: đúng 1 trong 2 (phiếu thu tiền mặt / thu tiền gửi).
  cashVoucherId  String?      @map("cash_voucher_id")
  cashVoucher    CashVoucher? @relation(fields: [cashVoucherId], references: [id], onDelete: Cascade)
  bankVoucherId  String?      @map("bank_voucher_id")
  bankVoucher    BankVoucher? @relation(fields: [bankVoucherId], references: [id], onDelete: Cascade)
  amount         Decimal      @db.Decimal(18, 2)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([salesVoucherId])
  @@index([cashVoucherId])
  @@index([bankVoucherId])
  @@map("payment_allocations")
}

// ── Tổng hợp (Chung_tu_nghiep_vu_khac) ──────────────────────────────────────

// Chứng từ nghiệp vụ khác (NVK) — bút toán tự do: hàng về trước hóa đơn về sau,
// giải ngân vay, bù trừ công nợ, điều chỉnh… Định khoản tự nhập, không có TK mặc định.
model GeneralVoucher {
  id          String               @id @default(uuid())
  voucherNo   String               @unique @map("voucher_no")
  postingDate DateTime             @map("posting_date") @db.Date
  voucherDate DateTime             @map("voucher_date") @db.Date
  description String?
  totalAmount Decimal              @default(0) @map("total_amount") @db.Decimal(18, 2)
  branchId    String?              @map("branch_id")
  posted      Boolean              @default(true)
  lines       GeneralVoucherLine[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")

  @@index([postingDate])
  @@map("general_vouchers")
}

// Dòng hạch toán (bút toán kép) của chứng từ nghiệp vụ khác.
model GeneralVoucherLine {
  id            String         @id @default(uuid())
  voucherId     String         @map("voucher_id")
  voucher       GeneralVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  lineNo        Int            @map("line_no")
  description   String?
  debitAccount  String         @map("debit_account")
  creditAccount String         @map("credit_account")
  amount        Decimal        @db.Decimal(18, 2)
  partnerId     String?        @map("partner_id")
  partnerName   String?        @map("partner_name")

  @@index([voucherId])
  @@map("general_voucher_lines")
}

// ── Danh mục (05-danh-muc) ───────────────────────────────────────────────────

// Tính chất vật tư hàng hóa (Danh_sach_hang_hoa_dich_vu.xlsx cột "Tính chất").
enum ProductType {
  GOODS // Hàng hóa
  SERVICE // Dịch vụ
  FINISHED // Thành phẩm
  MATERIAL // Nguyên vật liệu
  TOOL // Công cụ dụng cụ
}

// Vật tư, hàng hóa, dịch vụ (Danh_sach_hang_hoa_dich_vu.xlsx).
// Danh mục hàng hóa dùng chung: gắn vào dòng chứng từ mua/bán/nhập/xuất kho.
// groupCode / defaultWarehouseCode tham chiếu lỏng (không FK, như Customer.groupId).
// Các cột TK ngầm định gợi ý định khoản khi lập chứng từ; giá/tồn tối thiểu là Decimal.
model Product {
  id                   String      @id @default(uuid())
  code                 String      @unique // Mã
  name                 String // Tên
  type                 ProductType @default(GOODS) // Tính chất
  groupCode            String?     @map("group_code") // Nhóm VTHH (mã nhóm)
  unit                 String? // Đơn vị tính chính
  description          String? // Mô tả
  purchaseDescription  String?     @map("purchase_description") // Diễn giải khi mua
  saleDescription      String?     @map("sale_description") // Diễn giải khi bán
  defaultWarehouseCode String?     @map("default_warehouse_code") // Mã kho ngầm định
  defaultWarehouseName String?     @map("default_warehouse_name") // Kho ngầm định
  inventoryAccount     String?     @map("inventory_account") // TK Kho
  revenueAccount       String?     @map("revenue_account") // TK Doanh thu
  discountAccount      String?     @map("discount_account") // TK chiết khấu
  saleReturnAccount    String?     @map("sale_return_account") // TK Trả lại
  costAccount          String?     @map("cost_account") // TK chi phí
  purchasePrice        Decimal?    @map("purchase_price") @db.Decimal(18, 2) // Đơn giá mua gần nhất
  salePrice            Decimal?    @map("sale_price") @db.Decimal(18, 2) // Đơn giá bán 1
  minStock             Decimal?    @map("min_stock") @db.Decimal(18, 2) // Số lượng tồn tối thiểu
  vatRate              String?     @map("vat_rate") // Thuế suất GTGT (10/8/KCT/…)
  isActive             Boolean     @default(true) @map("is_active") // Trạng thái: Đang sử dụng

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")

  openingBalances InventoryOpeningBalance[]

  @@index([name])
  @@index([type])
  @@map("products")
}

// Kho (Danh_sach_kho.xlsx) — danh mục dùng chung phân hệ kho, mua, bán.
// Product.defaultWarehouseCode và *VoucherLine.warehouseId tham chiếu lỏng (không FK).
model Warehouse {
  id       String  @id @default(uuid())
  code     String  @unique // Mã kho
  name     String // Tên kho
  address  String? // Địa chỉ
  branch   String? // Chi nhánh
  isActive Boolean @default(true) @map("is_active") // Trạng thái: Đang sử dụng

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")

  @@index([name])
  @@map("warehouses")
}

// Nhân viên (Danh_sach_nhan_vien.xlsx) — danh mục dùng chung các phân hệ.
model Employee {
  id          String  @id @default(uuid())
  code        String  @unique
  name        String
  title       String? // Chức danh
  department  String? // Tên đơn vị (phòng ban)
  bankAccount String? @map("bank_account") // Số tài khoản
  bankName    String? @map("bank_name") // Tên ngân hàng
  isActive    Boolean @default(true) @map("is_active") // Trạng thái: Đang sử dụng

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")

  @@index([name])
  @@map("employees")
}

// Nhóm khách hàng, nhà cung cấp (Danh_sach_nhom_khach_hang_nha_cung_cap.xlsx).
// Customer.groupId / Supplier.groupId tham chiếu lỏng tới bảng này.
model PartnerGroup {
  id          String  @id @default(uuid())
  code        String  @unique
  name        String
  description String? // Diễn giải
  isActive    Boolean @default(true) @map("is_active") // Trạng thái: Đang sử dụng

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")

  @@index([name])
  @@map("partner_groups")
}

// Nhóm vật tư, hàng hóa, dịch vụ (Danh_sach_nhom_vat_tu_hang_hoa_dich_vu.xlsx).
// Product.groupCode tham chiếu lỏng (không FK) tới cột code này.
model ProductGroup {
  id       String  @id @default(uuid())
  code     String  @unique // Mã nhóm vật tư, hàng hóa, dịch vụ
  name     String // Tên nhóm vật tư, hàng hóa, dịch vụ
  isActive Boolean @default(true) @map("is_active") // Trạng thái: Đang sử dụng

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")

  @@index([name])
  @@map("product_groups")
}

// Tài khoản ngân hàng (Danh_sach_tai_khoan_ngan_hang.xlsx).
// Số tài khoản là khóa tự nhiên (unique). Có thể chứa hậu tố mô tả (vd "030079181540 VAY").
model BankAccount {
  id            String  @id @default(uuid())
  accountNumber String  @unique @map("account_number") // Số tài khoản
  bankName      String  @map("bank_name") // Tên ngân hàng
  bankBranch    String? @map("bank_branch") // Tên chi nhánh ngân hàng
  accountHolder String? @map("account_holder") // Chủ tài khoản
  branch        String? // Chi nhánh (đơn vị)
  isActive      Boolean @default(true) @map("is_active") // Trạng thái: Đang sử dụng

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")

  openingBalances BankAccountOpeningBalance[]

  @@index([bankName])
  @@map("bank_accounts")
}

// Khoản mục chi phí (Danh_sach_khoan_muc_chi_phi_.xlsx).
// Phân cấp cha-con qua parentId (tham chiếu lỏng, như Customer.groupId).
// Nhập khẩu tự gán cha theo tiền tố dấu chấm của mã (MTC.VL → cha MTC).
model ExpenseItem {
  id          String  @id @default(uuid())
  code        String  @unique
  name        String
  description String? // Diễn giải
  parentId    String? @map("parent_id") // Thuộc khoản mục (id cha)
  isActive    Boolean @default(true) @map("is_active") // Trạng thái: Đang sử dụng

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")

  @@index([name])
  @@index([parentId])
  @@map("expense_items")
}

// Tính chất tài khoản (Danh_sach_he_thong_tai_khoan_.xlsx cột "Tính chất").
enum AccountNature {
  DEBIT // Dư Nợ
  CREDIT // Dư Có
  DUAL // Lưỡng tính
}

// Hệ thống tài khoản kế toán (Danh_sach_he_thong_tai_khoan_.xlsx — TT 133/200).
// Phân cấp cha-con qua parentId (tham chiếu lỏng, như ExpenseItem).
// Nhập khẩu tự gán cha theo tiền tố số tài khoản (1111 → cha 111 → cha null).
model Account {
  id          String        @id @default(uuid())
  number      String        @unique // Số tài khoản
  name        String // Tên tài khoản
  nature      AccountNature // Tính chất
  nameEn      String?       @map("name_en") // Tên tiếng Anh
  description String? // Diễn giải
  parentId    String?       @map("parent_id") // Thuộc tài khoản (id cha)
  isActive    Boolean       @default(true) @map("is_active") // Trạng thái: Đang sử dụng

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")

  @@index([name])
  @@index([parentId])
  @@map("accounts")
}

// Loại đối tượng tập hợp chi phí (Doi_tuong_tap_hop_chi_phi.xlsx cột "Loại").
enum CostObjectType {
  PRODUCT // Sản phẩm
  WORKSHOP // Phân xưởng
  OTHER // Khác
}

// Đối tượng tập hợp chi phí (Doi_tuong_tap_hop_chi_phi.xlsx).
model CostObject {
  id          String         @id @default(uuid())
  code        String         @unique
  name        String
  type        CostObjectType @default(PRODUCT) // Loại: Sản phẩm / Phân xưởng / Khác
  description String? // Diễn giải
  isActive    Boolean        @default(true) @map("is_active") // Trạng thái: Đang sử dụng

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")

  @@index([name])
  @@map("cost_objects")
}

// Loại mục thu/chi (Danh_sach_muc_thuchi.xlsx cột "Loại").
enum IncomeExpenseType {
  INCOME // Mục thu
  EXPENSE // Mục chi
}

// Mục thu/chi (Danh_sach_muc_thuchi.xlsx).
// Phân loại dòng tiền khi lập phiếu thu / phiếu chi (mã + tên + loại thu|chi + định kỳ).
model IncomeExpenseItem {
  id        String            @id @default(uuid())
  code      String            @unique // Mã mục thu/chi
  name      String // Tên mục thu/chi
  type      IncomeExpenseType // Loại: Mục thu / Mục chi
  recurring Boolean           @default(false) // Phát sinh định kỳ
  isActive  Boolean           @default(true) @map("is_active") // Trạng thái: Đang sử dụng

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")

  @@index([name])
  @@map("income_expense_items")
}

// Danh mục ngân hàng (Danh_sach_ngan_hang.xlsx).
// Danh sách ngân hàng dùng chung (tên viết tắt + tên đầy đủ), gắn vào tài khoản ngân hàng.
model Bank {
  id        String  @id @default(uuid())
  shortName String  @unique @map("short_name") // Tên viết tắt (VD: VCB, BIDV)
  fullName  String  @map("full_name") // Tên đầy đủ
  isActive  Boolean @default(true) @map("is_active") // Trạng thái: Đang sử dụng

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")

  @@index([fullName])
  @@map("banks")
}

// Bên kết chuyển (Danh_sach_tai_khoan_ket_chuyen.xlsx cột "Bên kết chuyển").
enum TransferSide {
  DEBIT // Nợ
  CREDIT // Có
  BOTH // Hai bên
}

// Tài khoản kết chuyển (Danh_sach_tai_khoan_ket_chuyen.xlsx).
// Cấu hình bút toán kết chuyển cuối kỳ: TK "từ" → TK "đến", chạy theo thứ tự tăng dần.
// Mã kết chuyển là khóa tự nhiên (unique), dạng "<từ>-<đến>" (VD "511-911").
model TransferAccount {
  id          String       @id @default(uuid())
  order       Int          @map("transfer_order") // Thứ tự kết chuyển (chạy tăng dần)
  code        String       @unique // Mã kết chuyển (VD "511-911")
  fromAccount String       @map("from_account") // Kết chuyển từ (mã TK)
  toAccount   String       @map("to_account") // Kết chuyển đến (mã TK)
  side        TransferSide @default(BOTH) // Bên kết chuyển: Nợ / Có / Hai bên
  description String? // Diễn giải
  isActive    Boolean      @default(true) @map("is_active") // Trạng thái: Đang sử dụng

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")

  @@index([order])
  @@map("transfer_accounts")
}

// Tài khoản ngầm định (Danh_sach_tai_khoan_ngam_dinh.xlsx).
// Mỗi loại nghiệp vụ gợi ý sẵn cặp TK Nợ / TK Có khi lập chứng từ.
// Không có mã riêng — định danh theo loại nghiệp vụ (tên có thể trùng nếu khác định khoản).
model DefaultAccount {
  id            String  @id @default(uuid())
  order         Int     @map("default_order") // STT trong danh sách MISA (giữ thứ tự gốc)
  name          String  // Loại nghiệp vụ (cột "Loại")
  debitAccount  String? @map("debit_account") // TK Nợ ngầm định (có thể để trống)
  creditAccount String? @map("credit_account") // TK Có ngầm định (có thể để trống)
  isActive      Boolean @default(true) @map("is_active") // Trạng thái: Đang sử dụng

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")

  @@index([order])
  @@index([name])
  @@map("default_accounts")
}

// Loại chứng từ (Danh_sach_loai_chung_tu.xlsx).
// Danh mục phân loại chứng từ (VD PC "Phiếu chi", PT "Phiếu thu"); mã là khóa tự nhiên (unique).
model VoucherType {
  id       String  @id @default(uuid())
  code     String  @unique // Mã loại chứng từ (VD "PC")
  name     String // Tên loại chứng từ
  isActive Boolean @default(true) @map("is_active") // Trạng thái: Đang sử dụng

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")

  @@index([code])
  @@map("voucher_types")
}

// Đơn vị tính (Danh_sach_don_vi_tinh.xlsx).
// Danh mục đơn vị đo lường vật tư/hàng hóa (VD "Cái", "kg", "Thùng"); tên là khóa tự nhiên (unique).
model Unit {
  id          String  @id @default(uuid())
  name        String  @unique // Đơn vị tính (VD "Cái")
  description String? // Mô tả
  isActive    Boolean @default(true) @map("is_active") // Trạng thái: Đang sử dụng

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")

  @@index([name])
  @@map("units")
}

// ── Số dư ban đầu (opening-balance) ──────────────────────────────────────────

// Số dư tài khoản đầu kỳ — mỗi TK 1 dòng Dư Nợ/Dư Có (Danh_sach_so_du_tai_khoan.xlsx).
// Lưu cả TK tổng hợp lẫn TK chi tiết như file MISA; không tự cộng dồn cha-con.
model AccountOpeningBalance {
  id           String  @id @default(uuid())
  accountCode  String  @unique @map("account_code")
  accountName  String  @map("account_name")
  debitAmount  Decimal @default(0) @map("debit_amount") @db.Decimal(18, 2)
  creditAmount Decimal @default(0) @map("credit_amount") @db.Decimal(18, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("account_opening_balances")
}

// Số dư công nợ đầu kỳ chi tiết theo đối tượng cho 1 TK công nợ (131 theo KH, 331 theo NCC…).
// Đa hình theo partnerType (không FK cứng vì đối tượng ở 2 bảng Customer/Supplier).
// TK công nợ trong AccountOpeningBalance = tổng cộng các dòng ở đây theo cùng accountCode.
model PartnerOpeningBalance {
  id           String      @id @default(uuid())
  accountCode  String      @map("account_code") // Số TK công nợ (vd 131, 1311, 331)
  partnerType  PartnerType @map("partner_type") // CUSTOMER (131) / SUPPLIER (331)
  partnerId    String      @map("partner_id") // id Customer hoặc Supplier tùy partnerType
  debitAmount  Decimal     @default(0) @map("debit_amount") @db.Decimal(18, 2)
  creditAmount Decimal     @default(0) @map("credit_amount") @db.Decimal(18, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([accountCode, partnerType, partnerId])
  @@index([accountCode])
  @@map("partner_opening_balances")
}

// Tài sản cố định đầu kỳ (Danh_sach_tai_san_co_dinh_dau_ky.xlsx) — danh sách khai báo TSCĐ
// đang dùng trước ngày bắt đầu hạch toán. TK nguyên giá (211x) Dư Nợ / TK khấu hao (214x) Dư Có
// trong AccountOpeningBalance = tổng cộng các dòng ở đây theo cùng mã TK.
model FixedAssetOpeningBalance {
  id                      String   @id @default(uuid())
  code                    String   @unique @map("code") // Mã tài sản
  name                    String   @map("name") // Tên tài sản
  assetType               String   @map("asset_type") // Loại tài sản (Nhà cửa, Máy móc…)
  department              String   @default("") @map("department") // Đơn vị sử dụng
  originalCost            Decimal  @default(0) @map("original_cost") @db.Decimal(18, 2) // Nguyên giá
  depreciableValue        Decimal  @default(0) @map("depreciable_value") @db.Decimal(18, 2) // Giá trị tính KH
  accumulatedDepreciation Decimal  @default(0) @map("accumulated_depreciation") @db.Decimal(18, 2) // Hao mòn lũy kế
  acquisitionDate         DateTime @map("acquisition_date") @db.Date // Ngày ghi tăng
  depreciationDate        DateTime @map("depreciation_date") @db.Date // Ngày bắt đầu tính KH
  usefulLifeMonths        Decimal  @default(0) @map("useful_life_months") @db.Decimal(10, 2) // Thời gian SD (tháng)
  remainingMonths         Decimal  @default(0) @map("remaining_months") @db.Decimal(10, 2) // Thời gian SD còn lại (tháng)
  assetAccount            String   @map("asset_account") // TK nguyên giá (vd 21112)
  depreciationAccount     String   @map("depreciation_account") // TK khấu hao (vd 2141)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("fixed_asset_opening_balances")
}

// Số dư tiền gửi đầu kỳ chi tiết theo từng tài khoản ngân hàng cho 1 TK tiền gửi (1121, 1122…).
// TK tiền gửi trong AccountOpeningBalance = tổng cộng các dòng ở đây theo cùng accountCode.
model BankAccountOpeningBalance {
  id            String      @id @default(uuid())
  accountCode   String      @map("account_code") // Số TK tiền gửi (vd 1121, 1122)
  bankAccountId String      @map("bank_account_id")
  bankAccount   BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  debitAmount   Decimal     @default(0) @map("debit_amount") @db.Decimal(18, 2)
  creditAmount  Decimal     @default(0) @map("credit_amount") @db.Decimal(18, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([accountCode, bankAccountId])
  @@index([accountCode])
  @@map("bank_account_opening_balances")
}

// Tồn kho đầu kỳ vật tư, hàng hóa, CCDC (Danh_sach_ton_kho_vthh.xlsx) — mỗi dòng 1 VTHH/1 kho.
// warehouseCode tham chiếu lỏng tới Warehouse.code (như Product.defaultWarehouseCode).
// TK kho (152/153/155/156) trong AccountOpeningBalance = tổng Giá trị tồn các dòng ở đây
// nhóm theo TK kho của từng VTHH (Product.inventoryAccount, thiếu thì suy từ Product.type).
model InventoryOpeningBalance {
  id            String  @id @default(uuid())
  productId     String  @map("product_id")
  product       Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseCode String  @map("warehouse_code") // Mã kho
  quantity      Decimal @default(0) @db.Decimal(18, 2) // Số lượng tồn
  amount        Decimal @default(0) @db.Decimal(18, 2) // Giá trị tồn

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([productId, warehouseCode])
  @@map("inventory_opening_balances")
}

// ── Khóa sổ kỳ kế toán (general) ────────────────────────────────────────────

// Khóa sổ kỳ kế toán: 1 dòng duy nhất (id = 1). Chứng từ có ngày hạch toán ≤ lock_date
// không được thêm/sửa/xóa. Bỏ khóa sổ = xóa dòng.
model BookLock {
  id        Int      @id @default(1)
  lockDate  DateTime @map("lock_date") @db.Date
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("book_locks")
}

// ── Cơ cấu tổ chức (catalog) ────────────────────────────────────────────────

// Cấp tổ chức. Đồng bộ với OrgUnitLevel trong packages/shared/src/enums.
enum OrgUnitLevel {
  COMPANY // Tổng công ty/Công ty
  BRANCH // Chi nhánh
  DEPARTMENT // Phòng ban
}

// Cơ cấu tổ chức — chi nhánh, phòng ban (Danh_sach_co_cau_to_chuc.xlsx).
model OrganizationUnit {
  id       String       @id @default(uuid())
  code     String       @unique // Mã đơn vị
  name     String // Tên đơn vị
  address  String? // Địa chỉ
  level    OrgUnitLevel @default(DEPARTMENT) // Cấp tổ chức
  parentId String?      @map("parent_id") // Thuộc đơn vị (id cha) — null = đơn vị gốc
  isActive Boolean      @default(true) @map("is_active") // Trạng thái: Đang sử dụng

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")

  @@index([name])
  @@index([parentId])
  @@map("organization_units")
}

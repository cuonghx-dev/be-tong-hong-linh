// Prisma schema — model bổ sung theo nghiệp vụ (misa-specs).
// Nguyên tắc: tiền dùng Decimal @db.Decimal(18,2); audit created_at/updated_at/created_by;
// soft delete bằng cờ trạng thái, KHÔNG xóa cứng chứng từ; bút toán kép cân Nợ = Có.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// TODO: thêm model theo feature còn lại: catalog, sales, purchase, bank, inventory, report, auth.

// ── Tiền mặt (01-tien-mat) ──────────────────────────────────────────────────

// Loại chứng từ quỹ: Phiếu thu (PT) / Phiếu chi (PC).
enum CashVoucherType {
  RECEIPT
  PAYMENT
}

// Loại nghiệp vụ (§5) — quyết định định khoản mặc định + nguồn sinh phiếu.
enum CashVoucherCategory {
  SALES_CASH
  RECEIPT_BANK_WITHDRAW
  RECEIPT_EMPLOYEE_ADVANCE
  RECEIPT_CUSTOMER
  RECEIPT
  RECEIPT_LOAN_RECOVERY
  PAYMENT_EMPLOYEE_ADVANCE
  PAYMENT
  DEPOSIT_TO_BANK
  PAYMENT_SUPPLIER
  PAYMENT_PURCHASE_WITH_INVOICE
  PAYMENT_SALARY_ADVANCE
  PAYMENT_SALARY
  PAYMENT_TO_BRANCH
  PAYMENT_LOAN
  PAYMENT_CIT_TAX
  PURCHASE_SERVICE_CASH
  PURCHASE_GOODS_CASH
}

// Đối tượng liên kết: Khách hàng / Nhà cung cấp / Nhân viên.
enum PartnerType {
  CUSTOMER
  SUPPLIER
  EMPLOYEE
}

// Phiếu thu/chi tiền mặt.
model CashVoucher {
  id              String              @id @default(uuid())
  type            CashVoucherType
  category        CashVoucherCategory
  voucherNo       String              @unique @map("voucher_no")
  postingDate     DateTime            @map("posting_date") @db.Date
  voucherDate     DateTime            @map("voucher_date") @db.Date
  partnerType     PartnerType?        @map("partner_type")
  partnerId       String?             @map("partner_id")
  partnerName     String?             @map("partner_name")
  payerReceiver   String?             @map("payer_receiver")
  address         String?
  employeeId      String?             @map("employee_id")
  reason          String?
  attachmentCount Int                 @default(0) @map("attachment_count")
  totalAmount     Decimal             @default(0) @map("total_amount") @db.Decimal(18, 2)
  branchId        String?             @map("branch_id")
  lines           CashVoucherLine[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")

  @@index([type, postingDate])
  @@index([partnerId])
  @@map("cash_vouchers")
}

// Dòng hạch toán (bút toán kép) của phiếu thu/chi.
model CashVoucherLine {
  id            String      @id @default(uuid())
  voucherId     String      @map("voucher_id")
  voucher       CashVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  lineNo        Int         @map("line_no")
  description   String?
  debitAccount  String      @map("debit_account")
  creditAccount String      @map("credit_account")
  amount        Decimal     @db.Decimal(18, 2)
  operation     String?
  partnerId     String?     @map("partner_id")
  partnerName   String?     @map("partner_name")
  costItemId    String?     @map("cost_item_id")
  bankAccountNo String?     @map("bank_account_no")
  bankName      String?     @map("bank_name")

  @@index([voucherId])
  @@map("cash_voucher_lines")
}

// ── Tiền gửi (02-tien-gui) ──────────────────────────────────────────────────

// Loại chứng từ tiền gửi: Thu tiền gửi (NTTK) / Ủy nhiệm chi (UNC).
enum BankVoucherType {
  RECEIPT
  PAYMENT
}

// Loại nghiệp vụ (§5) — quyết định định khoản mặc định + nguồn sinh phiếu.
enum BankVoucherCategory {
  RECEIPT
  PAYMENT
  SALES_BANK
  PURCHASE_SERVICE_BANK
  PURCHASE_GOODS_BANK
}

// Phương thức thanh toán khi chi (§4) — chỉ dùng cho UNC.
enum BankPaymentMethod {
  UNC
  TRANSFER
  CHECK
}

// Chứng từ thu (NTTK) / chi (UNC) tiền gửi.
model BankVoucher {
  id                String              @id @default(uuid())
  type              BankVoucherType
  category          BankVoucherCategory
  voucherNo         String              @unique @map("voucher_no")
  paymentMethod     BankPaymentMethod?  @map("payment_method")
  isBatchTransfer   Boolean             @default(false) @map("is_batch_transfer")
  internalRef       String?             @map("internal_ref")
  postingDate       DateTime            @map("posting_date") @db.Date
  voucherDate       DateTime            @map("voucher_date") @db.Date
  bankAccountNo     String?             @map("bank_account_no")
  bankName          String?             @map("bank_name")
  receiverAccountNo String?             @map("receiver_account_no")
  partnerType       PartnerType?        @map("partner_type")
  partnerId         String?             @map("partner_id")
  partnerName       String?             @map("partner_name")
  address           String?
  employeeId        String?             @map("employee_id")
  reason            String?
  reference         String?
  attachmentCount   Int                 @default(0) @map("attachment_count")
  totalAmount       Decimal             @default(0) @map("total_amount") @db.Decimal(18, 2)
  branchId          String?             @map("branch_id")
  lines             BankVoucherLine[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")

  @@index([type, postingDate])
  @@index([partnerId])
  @@map("bank_vouchers")
}

// Dòng hạch toán (bút toán kép) của chứng từ thu/chi tiền gửi.
model BankVoucherLine {
  id            String      @id @default(uuid())
  voucherId     String      @map("voucher_id")
  voucher       BankVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  lineNo        Int         @map("line_no")
  description   String?
  debitAccount  String      @map("debit_account")
  creditAccount String      @map("credit_account")
  amount        Decimal     @db.Decimal(18, 2)
  partnerId     String?     @map("partner_id")
  partnerName   String?     @map("partner_name")

  @@index([voucherId])
  @@map("bank_voucher_lines")
}

// ── Mua hàng (03-mua-hang) ───────────────────────────────────────────────────

// Loại chứng từ mua hàng (§5): nhập kho / không qua kho / dịch vụ.
enum PurchaseVoucherType {
  STOCK
  NON_STOCK
  SERVICE
}

// Nguồn gốc hàng mua (§5): trong nước / nhập khẩu.
enum PurchaseOrigin {
  DOMESTIC
  IMPORT
}

// Hình thức thanh toán khi lập chứng từ.
enum PurchasePaymentMode {
  UNPAID
  IMMEDIATE
}

// Trạng thái nhận hóa đơn.
enum PurchaseReceiveStatus {
  NOT_RECEIVED
  RECEIVED
}

// Trạng thái thanh toán công nợ.
enum PurchasePaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

// Loại nhà cung cấp.
enum SupplierType {
  ORG
  INDIVIDUAL
}

// Hình thức thanh toán (khi thanh toán ngay).
enum PaymentMethod {
  CASH
  BANK_TRANSFER
}

// Tính chất hàng hóa - dịch vụ.
enum ItemNature {
  GOODS
  FINISHED_GOOD
  SERVICE
  MATERIAL
  TOOL
}

// Giảm thuế theo quy định.
enum ItemTaxReduction {
  UNDETERMINED
  REDUCED
  NOT_REDUCED
}

// Hàng hóa - dịch vụ (Danh sách HHDV - 03-mua-hang).
model InventoryItem {
  id                  String           @id @default(uuid())
  code                String           @unique
  name                String
  nature              ItemNature       @default(GOODS)
  taxReduction        ItemTaxReduction @default(UNDETERMINED) @map("tax_reduction")
  groupName           String?          @map("group_name")
  unit                String?
  stockQuantity       Decimal          @default(0) @map("stock_quantity") @db.Decimal(18, 2)
  stockValue          Decimal          @default(0) @map("stock_value") @db.Decimal(18, 2)
  minStock            Decimal          @default(0) @map("min_stock") @db.Decimal(18, 2)
  warrantyMonths      Int?             @map("warranty_months")
  origin              String?
  description         String?
  purchaseDescription String?          @map("purchase_description")
  salesDescription    String?          @map("sales_description")
  defaultWarehouse    String?          @map("default_warehouse")
  stockAccount        String?          @map("stock_account")
  revenueAccount      String?          @map("revenue_account")
  expenseAccount      String?          @map("expense_account")
  purchasePrice       Decimal          @default(0) @map("purchase_price") @db.Decimal(18, 2)
  salePrice           Decimal          @default(0) @map("sale_price") @db.Decimal(18, 2)
  vatRate             Decimal          @default(0) @map("vat_rate") @db.Decimal(5, 2)
  priceAfterTax       Boolean          @default(false) @map("price_after_tax")
  branchName          String?          @map("branch_name")
  isActive            Boolean          @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")

  @@index([name])
  @@index([nature])
  @@map("inventory_items")
}

// Nhà cung cấp (§6).
model Supplier {
  id                 String       @id @default(uuid())
  code               String       @unique
  name               String
  type               SupplierType @default(ORG)
  isCustomer         Boolean      @default(false) @map("is_customer")
  taxCode            String?      @map("tax_code")
  budgetRelationCode String?      @map("budget_relation_code")
  phone              String?
  website            String?
  address            String?
  groupId            String?      @map("group_id")
  employeeId         String?      @map("employee_id")
  isInternal         Boolean      @default(false) @map("is_internal")
  debtAmount         Decimal      @default(0) @map("debt_amount") @db.Decimal(18, 2)
  invoiceRisk        String?      @map("invoice_risk")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")

  @@index([name])
  @@map("suppliers")
}

// Chứng từ mua hàng (§4).
model PurchaseVoucher {
  id                 String                @id @default(uuid())
  type               PurchaseVoucherType
  origin             PurchaseOrigin        @default(DOMESTIC)
  paymentMode        PurchasePaymentMode   @default(UNPAID) @map("payment_mode")
  paymentMethod      PaymentMethod?        @map("payment_method")
  receiveWithInvoice Boolean               @default(false) @map("receive_with_invoice")
  voucherNo          String                @unique @map("voucher_no")
  invoiceNo          String?               @map("invoice_no")
  postingDate        DateTime              @map("posting_date") @db.Date
  voucherDate        DateTime              @map("voucher_date") @db.Date
  supplierId         String?               @map("supplier_id")
  supplierName       String?               @map("supplier_name")
  deliverer          String?
  address            String?
  employeeId         String?               @map("employee_id")
  description        String?
  attachmentCount    Int                   @default(0) @map("attachment_count")
  contractNo         String?               @map("contract_no")
  paymentTermId      String?               @map("payment_term_id")
  creditDays         Int?                  @map("credit_days")
  dueDate            DateTime?             @map("due_date") @db.Date
  totalGoods         Decimal               @default(0) @map("total_goods") @db.Decimal(18, 2)
  totalVat           Decimal               @default(0) @map("total_vat") @db.Decimal(18, 2)
  totalPayment       Decimal               @default(0) @map("total_payment") @db.Decimal(18, 2)
  purchaseCost       Decimal               @default(0) @map("purchase_cost") @db.Decimal(18, 2)
  stockValue         Decimal               @default(0) @map("stock_value") @db.Decimal(18, 2)
  einvoiceLookupCode String?               @map("einvoice_lookup_code")
  einvoiceLookupUrl  String?               @map("einvoice_lookup_url")
  receiveStatus      PurchaseReceiveStatus @default(NOT_RECEIVED) @map("receive_status")
  paymentStatus      PurchasePaymentStatus @default(UNPAID) @map("payment_status")
  branchId           String?               @map("branch_id")
  lines              PurchaseVoucherLine[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")

  @@index([type, postingDate])
  @@index([supplierId])
  @@map("purchase_vouchers")
}

// Dòng hàng tiền của chứng từ mua hàng.
model PurchaseVoucherLine {
  id             String          @id @default(uuid())
  voucherId      String          @map("voucher_id")
  voucher        PurchaseVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  lineNo         Int             @map("line_no")
  itemId         String?         @map("item_id")
  itemName       String?         @map("item_name")
  warehouseId    String?         @map("warehouse_id")
  stockAccount   String?         @map("stock_account")
  payableAccount String          @map("payable_account")
  unit           String?
  quantity       Decimal         @default(0) @db.Decimal(18, 4)
  unitPrice      Decimal         @default(0) @map("unit_price") @db.Decimal(18, 2)
  amount         Decimal         @default(0) @db.Decimal(18, 2)
  vatRate        Decimal         @default(0) @map("vat_rate") @db.Decimal(5, 2)
  vatAmount      Decimal         @default(0) @map("vat_amount") @db.Decimal(18, 2)
  vatAccount     String          @map("vat_account")

  @@index([voucherId])
  @@map("purchase_voucher_lines")
}

// ── Kho — Nhập kho (05-kho) ──────────────────────────────────────────────────

// Loại chứng từ Phiếu nhập kho — quyết định định khoản TK Nợ/Có mặc định.
enum InventoryReceiptType {
  PURCHASE
  FINISHED_GOODS
  SALES_RETURN
  OTHER
}

// Phiếu nhập kho (Nhập kho).
model InventoryReceipt {
  id              String                 @id @default(uuid())
  receiptType     InventoryReceiptType   @default(OTHER) @map("receipt_type")
  voucherNo       String                 @unique @map("voucher_no")
  postingDate     DateTime               @map("posting_date") @db.Date
  voucherDate     DateTime               @map("voucher_date") @db.Date
  partnerId       String?                @map("partner_id")
  partnerName     String?                @map("partner_name")
  address         String?
  deliverer       String?
  description     String?
  reference       String?
  attachmentCount Int                    @default(0) @map("attachment_count")
  totalAmount     Decimal                @default(0) @map("total_amount") @db.Decimal(18, 2)
  branchName      String?                @map("branch_name")
  lines           InventoryReceiptLine[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")

  @@index([receiptType, postingDate])
  @@map("inventory_receipts")
}

// Dòng hàng của phiếu nhập kho.
model InventoryReceiptLine {
  id            String           @id @default(uuid())
  receiptId     String           @map("receipt_id")
  receipt       InventoryReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  lineNo        Int              @map("line_no")
  itemId        String?          @map("item_id")
  itemName      String?          @map("item_name")
  warehouseId   String?          @map("warehouse_id")
  debitAccount  String?          @map("debit_account")
  creditAccount String?          @map("credit_account")
  unit          String?
  quantity      Decimal          @default(0) @db.Decimal(18, 4)
  unitPrice     Decimal          @default(0) @map("unit_price") @db.Decimal(18, 2)
  amount        Decimal          @default(0) @db.Decimal(18, 2)
  lotNo         String?          @map("lot_no")
  expiryDate    DateTime?        @map("expiry_date") @db.Date

  @@index([receiptId])
  @@map("inventory_receipt_lines")
}

// ── Kho — Xuất kho (05-kho) ──────────────────────────────────────────────────

// Lý do xuất kho — quyết định định khoản TK Nợ/Có mặc định.
enum GoodsIssueCategory {
  SALES
  PRODUCTION
  OTHER
}

// Phiếu xuất kho (Xuất kho) — ghi giảm tồn kho theo bút toán kép.
model GoodsIssueVoucher {
  id                 String             @id @default(uuid())
  category           GoodsIssueCategory @default(SALES)
  voucherNo          String             @unique @map("voucher_no")
  postingDate        DateTime           @map("posting_date") @db.Date
  voucherDate        DateTime           @map("voucher_date") @db.Date
  customerId         String?            @map("customer_id")
  customerName       String?            @map("customer_name")
  receiver           String?
  address            String?
  salesEmployeeId    String?            @map("sales_employee_id")
  description        String?
  attachmentCount    Int                @default(0) @map("attachment_count")
  deliveryLocation   String?            @map("delivery_location")
  totalAmount        Decimal            @default(0) @map("total_amount") @db.Decimal(18, 2)
  salesDocStatus     String?            @map("sales_doc_status")
  invoiceIssueStatus String?            @map("invoice_issue_status")
  taxAuthorityCode   String?            @map("tax_authority_code")
  branchName         String?            @map("branch_name")
  lines              GoodsIssueLine[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")

  @@index([category, postingDate])
  @@index([customerId])
  @@map("goods_issue_vouchers")
}

// Dòng hàng của phiếu xuất kho.
model GoodsIssueLine {
  id            String            @id @default(uuid())
  voucherId     String            @map("voucher_id")
  voucher       GoodsIssueVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  lineNo        Int               @map("line_no")
  itemId        String?           @map("item_id")
  itemName      String?           @map("item_name")
  warehouseId   String?           @map("warehouse_id")
  debitAccount  String            @map("debit_account")
  creditAccount String            @map("credit_account")
  unit          String?
  quantity      Decimal           @default(0) @db.Decimal(18, 4)
  unitPrice     Decimal           @default(0) @map("unit_price") @db.Decimal(18, 2)
  amount        Decimal           @default(0) @db.Decimal(18, 2)
  lotNo         String?           @map("lot_no")
  expiryDate    DateTime?         @map("expiry_date") @db.Date

  @@index([voucherId])
  @@map("goods_issue_lines")
}

// ── Lệnh sản xuất (05-kho) ───────────────────────────────────────────────────

// Tình trạng lệnh sản xuất (cột "Tình trạng" trên danh sách MISA).
enum ProductionOrderStatus {
  NOT_STARTED // Chưa thực hiện
  IN_PROGRESS // Đang thực hiện
  COMPLETED // Hoàn thành
}

// Loại dòng của lệnh sản xuất: thành phẩm cần sản xuất / NVL định mức tiêu hao.
enum ProductionOrderLineType {
  PRODUCT
  MATERIAL
}

// Lệnh sản xuất — chứng từ kế hoạch (không bút toán); sau đó sinh Phiếu xuất NVL (PX)
// và Phiếu nhập thành phẩm (PN). Hai cờ theo dõi đã lập đủ PN/PX.
model ProductionOrder {
  id              String                @id @default(uuid())
  voucherNo       String                @unique @map("voucher_no") // Số lệnh (vd LSX42/02.2026)
  orderDate       DateTime              @map("order_date") @db.Date // Ngày
  description     String? // Diễn giải
  receiptComplete Boolean               @default(false) @map("receipt_complete") // Đã lập đủ PN
  issueComplete   Boolean               @default(false) @map("issue_complete") // Đã lập đủ PX
  status          ProductionOrderStatus @default(IN_PROGRESS) // Tình trạng
  branchName      String?               @map("branch_name") // Chi nhánh
  lines           ProductionOrderLine[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")

  @@index([status, orderDate])
  @@map("production_orders")
}

// Dòng lệnh sản xuất (thành phẩm hoặc NVL định mức).
model ProductionOrderLine {
  id       String                  @id @default(uuid())
  orderId  String                  @map("order_id")
  order    ProductionOrder         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  lineNo   Int                     @map("line_no")
  lineType ProductionOrderLineType @default(PRODUCT) @map("line_type")
  itemId   String?                 @map("item_id")
  itemName String?                 @map("item_name")
  unit     String?
  quantity Decimal                 @default(0) @db.Decimal(18, 4)
  note     String?

  @@index([orderId])
  @@map("production_order_lines")
}

// ── Bán hàng (04-ban-hang) ───────────────────────────────────────────────────

// Loại nghiệp vụ chứng từ bán hàng (§3) — quyết định TK doanh thu mặc định.
enum SalesVoucherType {
  DOMESTIC_GOODS
  DOMESTIC_SERVICE
}

// Tùy chọn thanh toán (§3) — quyết định định khoản + sinh phiếu thu.
enum SalesPaymentMode {
  UNPAID
  PAID_NOW
}

// Trạng thái phát hành hóa đơn điện tử (§5).
enum InvoiceIssueStatus {
  UNISSUED
  CODE_ISSUED
}

// Loại đối tượng khách hàng (§8): Tổ chức / Cá nhân.
enum CustomerType {
  ORG
  INDIVIDUAL
}

// Khách hàng (§8) — đối tượng dùng chung KH/NCC qua cờ isSupplier.
model Customer {
  id                 String       @id @default(uuid())
  code               String       @unique
  name               String
  type               CustomerType @default(ORG)
  isSupplier         Boolean      @default(false) @map("is_supplier")
  isInternal         Boolean      @default(false) @map("is_internal")
  taxCode            String?      @map("tax_code")
  budgetRelationCode String?      @map("budget_relation_code")
  phone              String?
  website            String?
  address            String?
  groupId            String?      @map("group_id")
  salesEmployeeId    String?      @map("sales_employee_id")
  contactName        String?      @map("contact_name")
  contactEmail       String?      @map("contact_email")
  contactPhone       String?      @map("contact_phone")

  salesVouchers SalesVoucher[]
  invoices      Invoice[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")

  @@index([name])
  @@map("customers")
}

// Chứng từ bán hàng (§3) — ghi nhận doanh thu + công nợ phải thu.
model SalesVoucher {
  id                 String             @id @default(uuid())
  voucherNo          String             @unique @map("voucher_no")
  voucherType        SalesVoucherType   @map("voucher_type")
  paymentMode        SalesPaymentMode   @default(UNPAID) @map("payment_mode")
  paymentMethod      PaymentMethod?     @map("payment_method")
  isInventoryIssue   Boolean            @default(false) @map("is_inventory_issue")
  withInvoice        Boolean            @default(false) @map("with_invoice")
  isPosInvoice       Boolean            @default(false) @map("is_pos_invoice")
  postingDate        DateTime           @map("posting_date") @db.Date
  voucherDate        DateTime           @map("voucher_date") @db.Date
  customerId         String?            @map("customer_id")
  customer           Customer?          @relation(fields: [customerId], references: [id])
  customerName       String?            @map("customer_name")
  taxCode            String?            @map("tax_code")
  contactPerson      String?            @map("contact_person")
  address            String?
  salesEmployeeId    String?            @map("sales_employee_id")
  description        String?
  attachmentCount    Int                @default(0) @map("attachment_count")
  paymentTermId      String?            @map("payment_term_id")
  creditDays         Int?               @map("credit_days")
  dueDate            DateTime?          @map("due_date") @db.Date
  totalGoods         Decimal            @default(0) @map("total_goods") @db.Decimal(18, 2)
  totalVat           Decimal            @default(0) @map("total_vat") @db.Decimal(18, 2)
  totalAmount        Decimal            @default(0) @map("total_amount") @db.Decimal(18, 2)
  einvoiceLookupCode String?            @map("einvoice_lookup_code")
  einvoiceLookupUrl  String?            @map("einvoice_lookup_url")
  receiptId          String?            @map("receipt_id")
  branchId           String?            @map("branch_id")
  lines              SalesVoucherLine[]
  invoice            Invoice?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")

  @@index([voucherType, postingDate])
  @@index([customerId])
  @@index([paymentMode])
  @@map("sales_vouchers")
}

// Dòng hàng tiền của chứng từ bán hàng.
model SalesVoucherLine {
  id             String       @id @default(uuid())
  voucherId      String       @map("voucher_id")
  voucher        SalesVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  lineNo         Int          @map("line_no")
  itemId         String?      @map("item_id")
  itemName       String?      @map("item_name")
  tradeDiscount  Decimal      @default(0) @map("trade_discount") @db.Decimal(18, 2)
  debtAccount    String       @map("debt_account")
  revenueAccount String       @map("revenue_account")
  unit           String?
  quantity       Decimal      @default(0) @db.Decimal(18, 4)
  unitPrice      Decimal      @default(0) @map("unit_price") @db.Decimal(18, 2)
  amount         Decimal      @default(0) @db.Decimal(18, 2)
  vatRate        Decimal      @default(0) @map("vat_rate") @db.Decimal(5, 2)
  vatAmount      Decimal      @default(0) @map("vat_amount") @db.Decimal(18, 2)
  vatAccount     String       @map("vat_account")
  lotNo          String?      @map("lot_no")

  @@index([voucherId])
  @@map("sales_voucher_lines")
}

// Hóa đơn điện tử (§5) — sinh từ chứng từ bán hàng khi "Lập kèm hóa đơn".
model Invoice {
  id               String             @id @default(uuid())
  invoiceNo        String?            @map("invoice_no")
  invoiceType      String?            @map("invoice_type")
  status           String             @default("Hóa đơn mới")
  issueStatus      InvoiceIssueStatus @default(UNISSUED) @map("issue_status")
  templateNo       String?            @map("template_no")
  symbol           String?
  taxAuthorityCode String?            @map("tax_authority_code")
  taxSubmitStatus  String?            @map("tax_submit_status")
  sendStatus       String?            @map("send_status")
  customerReceived Boolean            @default(false) @map("customer_received")
  lookupCode       String?            @map("lookup_code")
  lookupUrl        String?            @map("lookup_url")
  paymentForm      String?            @map("payment_form")
  bankAccount      String?            @map("bank_account")
  invoiceDate      DateTime           @map("invoice_date") @db.Date
  posted           Boolean            @default(false)
  salesVoucherId   String?            @unique @map("sales_voucher_id")
  salesVoucher     SalesVoucher?      @relation(fields: [salesVoucherId], references: [id], onDelete: SetNull)
  customerId       String?            @map("customer_id")
  customer         Customer?          @relation(fields: [customerId], references: [id])
  customerName     String?            @map("customer_name")
  totalAmount      Decimal            @default(0) @map("total_amount") @db.Decimal(18, 2)
  branchId         String?            @map("branch_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")

  @@index([issueStatus, invoiceDate])
  @@index([customerId])
  @@map("invoices")
}
